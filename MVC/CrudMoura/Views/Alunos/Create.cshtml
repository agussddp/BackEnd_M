@model CrudMoura.Models.Alunos

<h1>Cadastro de Aluno</h1>

<form asp-action="ListarAlunos" method="post">

    <label asp-for="Nome">Nome do Aluno</label>
    <input asp-for="Nome" class="form-control">

    <br>
    <label asp-for="Idade">Idade</label>
    <input asp-for="Idade" class="form-control">

    <br>
    <label asp-for="Curso">Curso</label>
    <input asp-for="Curso" class="form-control">


    <br><br>
    <button class="btn btn-success">Cadastrar Aluno</button>

</form>
